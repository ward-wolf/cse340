<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>

    <h2><%= categoryDetails.name %></h2>

    <h3>Service Projects</h3>
    <% if (projects.length === 0) { %>
        <p>There are no service projects in this category yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => { %>
                <% const projectDate = project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
                <li>
                    <%= projectDate %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% }); %>
        </ul>
    <% } %>

    <p><a href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a></p>
</main>
<%- include('partials/footer') %>
