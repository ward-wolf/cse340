<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <% const projectDate = project.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
            <li><strong><%= projectDate %>: <%= project.title %> (<%= project.organization_name %>)</strong></li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
