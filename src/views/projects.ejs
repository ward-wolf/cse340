<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <% const projectDate = project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>
            <li>
                <strong><%= projectDate %>:
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</strong>
            </li>
        <% }); %>
    </ul>

    <p><a href="/new-project">Add a New Service Project</a></p>

</main>

<%- include('partials/footer') %>
