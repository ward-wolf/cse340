<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <h2>All Registered Users</h2>
    <% if (users.length === 0) { %>
        <p>There are no registered users yet.</p>
    <% } else { %>
        <ul>
            <% users.forEach(user => { %>
                <li>
                    <strong><%= user.name %></strong>
                    <p>Username: <%= user.email %></p>
                    <p>Role: <%= user.role_name %></p>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>

<%- include('partials/footer') %>
