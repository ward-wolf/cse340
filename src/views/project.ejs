<%- include('partials/header') %>
<main id="main-content">
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <% const projectDate = projectDetails.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); %>

    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= projectDate %></p>
    <p>Location: <%= projectDetails.location %></p>
    <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

    <h3>Categories</h3>
    <% if (categories.length === 0) { %>
        <p>This project has not been assigned to a category yet.</p>
    <% } else { %>
        <ul class="category-tags">
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }); %>
        </ul>
    <% } %>

    <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    <p><a href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a></p>
</main>
<%- include('partials/footer') %>
